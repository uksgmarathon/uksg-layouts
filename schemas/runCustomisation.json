{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Dashboard overrides for per-run customisation, keyed by nodecg-speedcontrol run ID; these take priority over any run/player customData.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "accentColour": {
        "type": "string"
      },
      "players": {
        "description": "Keyed by nodecg-speedcontrol player ID.",
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "badgeColour": {
              "type": "string"
            },
            "badgeLabel": {
              "type": "string"
            },
            "feedColour": {
              "type": "string"
            }
          }
        }
      }
    },
    "required": [
      "players"
    ]
  },
  "default": {}
}
