{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Whether the game layout's image rotation area should currently show an incentive for the current run instead of an image.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bidId": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "startTimestamp": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "bidId",
    "startTimestamp"
  ]
}
